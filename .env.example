# Copie este arquivo para .env e substitua pelos dados do seu projeto Neon.
DATABASE_DRIVER=neon
# Para PostgreSQL local: DATABASE_DRIVER=postgres e URL sem sslmode=require.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require

# Gere com: npx auth@latest secret
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# Configure antes de usar as funcionalidades de IA. Nunca exponha esta chave no navegador.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
# Tempo limite por chamada de IA, em milissegundos (1.000 a 90.000).
OPENROUTER_TIMEOUT_MS=60000
